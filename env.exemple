# =============================================================================
# ENVIRONMENT VARIABLES - Document Classification Pipeline
# =============================================================================

# --- Chemins absolus (adapter à votre machine) ---
DATA_DIR=/home/user/projet/data
MODELS_DIR=/home/user/projet/models
REPORTS_DIR=/home/user/projet/reports

# --- Tesseract OCR ---
# Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR	esseract.exe
# Linux/Mac: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# --- GPU ---
CUDA_VISIBLE_DEVICES=0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Configuration pipeline ---
PIPELINE_CONFIG=config.yaml
